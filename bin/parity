#!/usr/bin/env php
<?php

declare(strict_types=1);

const BASELINE_URL = 'https://raw.githubusercontent.com/wwebjs/whatsapp-web.js/942d236a11ad68807308b058303ba5256915979c/index.d.ts';
const BASELINE_VERSION = '1.34.7';
const BASELINE_COMMIT = '942d236a11ad68807308b058303ba5256915979c';
const BASELINE_SHA256 = 'a08f1fb5521d4988fd91c7ffe767a8a1d19bef3bbdab7616dd93a4e041e7b3b6';
const MATRIX_PATH = __DIR__.'/../api-matrix.json';

enum DeclarationKind: int
{
    case ClassLike = 1;
    case InterfaceLike = 2;
    case EnumLike = 3;
    case Alias = 4;
}

enum MemberKind: int
{
    case Method = 1;
    case Property = 2;
    case Event = 3;
    case EnumCase = 4;
}

enum ReturnKind: int
{
    case Unknown = 1;
    case Void = 2;
    case Boolean = 3;
    case Number = 4;
    case String = 5;
    case Array = 6;
    case NullableBoolean = 7;
    case NullableNumber = 8;
    case NullableString = 9;
    case NullableArray = 10;
}

enum ParameterKind: int
{
    case Unknown = 1;
    case Boolean = 2;
    case Number = 3;
    case String = 4;
    case Array = 5;
}

enum ParityState: int
{
    case Pending = 1;
    case InProgress = 2;
    case Complete = 3;
    case Blocked = 4;
}

/** @return never */
function fail(string $message): never
{
    fwrite(STDERR, "parity: {$message}\n");
    exit(1);
}

function baseline(): string
{
    $context = stream_context_create(['http' => ['timeout' => 30.0]]);
    $source = @file_get_contents(BASELINE_URL, false, $context);
    if (!is_string($source)) {
        fail('unable to download the pinned TypeScript contract');
    }
    if (!hash_equals(BASELINE_SHA256, hash('sha256', $source))) {
        fail('the pinned TypeScript contract digest changed');
    }

    return str_replace("\r\n", "\n", $source);
}

/**
 * @return list<array{
 *   id: string,
 *   kind: int,
 *   signatureHash: string,
 *   state: int,
 *   phpSymbol: string|null,
 *   members: list<array{id: string, name: string, kind: int, static: bool, minimumArguments: int|null, maximumArguments: int|null, parameterKinds: list<int>|null, parameterNames: list<string>|null, parameterTypeNames: list<string>|null, parameterTypeOverrides: list<int>, parameterNameOverrides: list<int>, constructorContractOverride: bool, returnKind: int|null, returnTypeName: string|null, returnCollectionElementTypeName: string|null, returnObjectShape: list<array{name: string, type: string, optional: bool}>|null, returnObjectTypeOverrides: list<string>, returnIndexSignature: array{keyType: string, valueType: string}|null, propertyTypeName: string|null, propertyOptional: bool|null, propertyTypeOverride: bool, propertyRuntimeNullable: bool, propertyCollectionElementTypeName: string|null, propertyObjectShape: list<array{name: string, type: string, optional: bool}>|null, propertyIndexSignature: array{keyType: string, valueType: string}|null, propertyStructureOverride: bool, propertyStructureTypeOverrides: list<string>, propertyUnionTypeNames: list<string>|null, returnTypeOverride: bool, runtimeNullable: bool, signatureHash: string, state: int, phpMember: string|null}>
 * }>
 */
function extractSymbols(string $source): array
{
    $source = preg_replace('~/\*.*?\*/~s', '', $source);
    if (!is_string($source)) {
        fail('unable to remove TypeScript comments');
    }
    $lines = explode("\n", $source);
    $symbols = [];

    for ($index = 0, $count = count($lines); $index < $count; ++$index) {
        if (preg_match(
            '/^    export (?:abstract )?(class|interface|enum|type) ([A-Za-z_$][A-Za-z0-9_$]*)/',
            $lines[$index],
            $match,
        ) !== 1) {
            continue;
        }

        $word = $match[1];
        $name = $match[2];
        $declaration = $lines[$index];
        if ($word === 'type') {
            while (!str_contains($declaration, ';') && ++$index < $count) {
                $declaration .= "\n".$lines[$index];
            }
        } else {
            $depth = substr_count($declaration, '{') - substr_count($declaration, '}');
            while ($depth > 0 && ++$index < $count) {
                $declaration .= "\n".$lines[$index];
                $depth += substr_count($lines[$index], '{') - substr_count($lines[$index], '}');
            }
        }

        $kind = match ($word) {
            'class' => DeclarationKind::ClassLike,
            'interface' => DeclarationKind::InterfaceLike,
            'enum' => DeclarationKind::EnumLike,
            'type' => DeclarationKind::Alias,
        };
        $members = extractMembers($declaration, $kind);
        foreach ($members as &$member) {
            $member['runtimeNullable'] = in_array($name.':'.$member['name'], [
                'Client:getProfilePicUrl',
                'Contact:getProfilePicUrl',
                'GroupChat:getInviteCode',
            ], true);
            $member['parameterTypeOverrides'] = match ($name.':'.$member['name']) {
                'Buttons:constructor' => [1],
                'Client:sendResponseToScheduledEvent' => [2],
                'Chat:sendMessage',
                'Channel:sendMessage',
                'GroupNotification:reply' => [1],
                'Client:sendMessage' => [2],
                'Message:edit' => [1],
                'Message:reply' => [1],
                default => [],
            };
            $member['constructorContractOverride'] = false;
            $member['parameterNameOverrides'] = match ($name.':'.$member['name']) {
                'Client:deleteAddressbookContact' => [1],
                default => [],
            };
            $member['returnTypeOverride'] = in_array($name.':'.$member['name'], [
                'Client:getChatById',
                'Message:getChat',
            ], true);
            $member['returnObjectTypeOverrides'] = match ($name.':'.$member['name']) {
                'Channel:getSubscribers' => ['role'],
                'Chat:getCustomerNote',
                'Client:getCustomerNote' => ['type'],
                default => [],
            };
            $member['propertyTypeOverride'] = in_array($name.':'.$member['name'], [
                'BusinessHoursOfDay:mode',
                'Contact:type',
                'GroupMembershipRequest:requestMethod',
                'Location:latitude',
                'Location:longitude',
                'Message:deviceType',
                'Message:duration',
                'Payment:paymentStatus',
                'Payment:paymentTxnStatus',
                'Reaction:ack',
                'ScheduledEventSendOptions:callType',
                'SearchChannelsOptions:view',
            ], true);
            $member['propertyRuntimeNullable'] = in_array($name.':'.$member['name'], [
                'Chat:lastMessage',
                'Client:info',
                'ClientInfo:phone',
                'Client:pupBrowser',
                'Client:pupPage',
                'Contact:sectionHeader',
                'GroupChat:owner',
                'Message:eventStartTime',
                'Message:location',
                'Message:orderId',
                'Message:pollName',
                'Payment:paymentNote',
            ], true);
            $member['propertyStructureOverride'] = false;
            $member['propertyStructureTypeOverrides'] = match ($name.':'.$member['name']) {
                'BusinessContact:businessProfile' => ['businessHours'],
                'ScheduledEvent:eventSendOptions' => ['callType', 'messageSecret'],
                default => [],
            };
        }
        unset($member);
        $symbols[] = [
            'id' => $name,
            'kind' => $kind->value,
            'signatureHash' => signatureHash($declaration),
            'state' => ParityState::Pending->value,
            'phpSymbol' => null,
            'members' => $members,
        ];
    }

    usort($symbols, static fn (array $left, array $right): int => $left['id'] <=> $right['id']);

    return $symbols;
}

/**
 * @return list<array{id: string, name: string, kind: int, static: bool, minimumArguments: int|null, maximumArguments: int|null, parameterKinds: list<int>|null, parameterNames: list<string>|null, parameterTypeNames: list<string>|null, parameterTypeOverrides: list<int>, parameterNameOverrides: list<int>, returnKind: int|null, returnTypeName: string|null, returnCollectionElementTypeName: string|null, returnObjectShape: list<array{name: string, type: string, optional: bool}>|null, returnObjectTypeOverrides: list<string>, returnIndexSignature: array{keyType: string, valueType: string}|null, propertyTypeName: string|null, propertyOptional: bool|null, propertyTypeOverride: bool, propertyRuntimeNullable: bool, propertyCollectionElementTypeName: string|null, propertyObjectShape: list<array{name: string, type: string, optional: bool}>|null, propertyIndexSignature: array{keyType: string, valueType: string}|null, propertyStructureOverride: bool, propertyStructureTypeOverrides: list<string>, propertyUnionTypeNames: list<string>|null, returnTypeOverride: bool, runtimeNullable: bool, signatureHash: string, state: int, phpMember: string|null}>
 */
function extractMembers(string $declaration, DeclarationKind $kind): array
{
    if ($kind === DeclarationKind::Alias) {
        return [];
    }

    $segments = [];
    $current = '';
    foreach (explode("\n", $declaration) as $line) {
        $startsMember = preg_match(
            '/^        (?:(?:public\s+)?(?:static\s+)?[A-Za-z_$][A-Za-z0-9_$]*|constructor\s*\(|on\s*\()/',
            $line,
        ) === 1;
        if ($startsMember && $current !== '') {
            $segments[] = $current;
            $current = '';
        }
        if ($startsMember || $current !== '') {
            $current .= ($current === '' ? '' : "\n").$line;
        }
    }
    if ($current !== '') {
        $segments[] = $current;
    }

    $grouped = [];
    foreach ($segments as $segment) {
        $trimmed = trim($segment);
        if ($trimmed === '' || $trimmed === '}') {
            continue;
        }

        if (preg_match("/^on\s*\(\s*event:\s*'([^']+)'/s", $trimmed, $match) === 1) {
            $memberKind = MemberKind::Event;
            $name = $match[1];
        } elseif ($kind === DeclarationKind::EnumLike
            && preg_match('/^([A-Za-z_$][A-Za-z0-9_$]*)\s*(?:=|,)/', $trimmed, $match) === 1
        ) {
            $memberKind = MemberKind::EnumCase;
            $name = $match[1];
        } elseif (preg_match(
            '/^(?:public\s+)?(?:static\s+)?([A-Za-z_$][A-Za-z0-9_$]*)\??\s*:\s*\(/',
            $trimmed,
            $match,
        ) === 1 || preg_match(
            '/^(?:public\s+)?(?:static\s+)?([A-Za-z_$][A-Za-z0-9_$]*)\s*\(/',
            $trimmed,
            $match,
        ) === 1) {
            $memberKind = MemberKind::Method;
            $name = $match[1];
        } elseif (preg_match(
            '/^(?:public\s+)?(?:readonly\s+)?([A-Za-z_$][A-Za-z0-9_$]*)\??\s*:/',
            $trimmed,
            $match,
        ) === 1) {
            $memberKind = MemberKind::Property;
            $name = $match[1];
        } else {
            continue;
        }

        $id = $memberKind->value.':'.$name;
        $static = preg_match('/^(?:public\s+)?static\s+/', $trimmed) === 1;
        $argumentContract = $memberKind === MemberKind::Method ? argumentContract($trimmed, $name) : null;
        $newMember = !isset($grouped[$id]);
        $grouped[$id] ??= [
            'id' => $id,
            'name' => $name,
            'kind' => $memberKind->value,
            'static' => $static,
            'minimumArguments' => $argumentContract[0] ?? null,
            'maximumArguments' => $argumentContract[1] ?? null,
            'parameterKinds' => $argumentContract[2] ?? null,
            'parameterNames' => $argumentContract[3] ?? null,
            'parameterTypeNames' => $argumentContract[4] ?? null,
            'parameterTypeOverrides' => [],
            'parameterNameOverrides' => [],
            'constructorContractOverride' => false,
            'returnKind' => $memberKind === MemberKind::Method ? returnKind($trimmed, $name)->value : null,
            'returnTypeName' => $memberKind === MemberKind::Method ? returnTypeName($trimmed, $name) : null,
            'returnCollectionElementTypeName' => $memberKind === MemberKind::Method
                ? collectionElementTypeName(returnTypeName($trimmed, $name))
                : null,
            'returnObjectShape' => $memberKind === MemberKind::Method
                ? objectShapeContract(returnTypeName($trimmed, $name))
                : null,
            'returnObjectTypeOverrides' => [],
            'returnIndexSignature' => $memberKind === MemberKind::Method
                ? indexSignatureContract(returnTypeName($trimmed, $name))
                : null,
            'propertyTypeName' => $memberKind === MemberKind::Property
                ? propertyTypeName($trimmed, $name)
                : null,
            'propertyOptional' => $memberKind === MemberKind::Property
                ? propertyOptional($trimmed, $name)
                : null,
            'propertyTypeOverride' => false,
            'propertyRuntimeNullable' => false,
            'propertyCollectionElementTypeName' => $memberKind === MemberKind::Property
                ? collectionElementTypeName(propertyTypeName($trimmed, $name))
                : null,
            'propertyObjectShape' => $memberKind === MemberKind::Property
                ? objectShapeContract(propertyTypeName($trimmed, $name))
                : null,
            'propertyIndexSignature' => $memberKind === MemberKind::Property
                ? indexSignatureContract(propertyTypeName($trimmed, $name))
                : null,
            'propertyStructureOverride' => false,
            'propertyStructureTypeOverrides' => [],
            'propertyUnionTypeNames' => $memberKind === MemberKind::Property
                ? unionTypeNames(propertyTypeName($trimmed, $name))
                : null,
            'returnTypeOverride' => false,
            'runtimeNullable' => false,
            'signatures' => [],
            'state' => ParityState::Pending->value,
            'phpMember' => null,
        ];
        $grouped[$id]['signatures'][] = signatureHash($trimmed);
        if ($argumentContract !== null) {
            $grouped[$id]['minimumArguments'] = min($grouped[$id]['minimumArguments'], $argumentContract[0]);
            $grouped[$id]['maximumArguments'] = max($grouped[$id]['maximumArguments'], $argumentContract[1]);
            if (!$newMember && $grouped[$id]['parameterKinds'] !== $argumentContract[2]) {
                $grouped[$id]['parameterKinds'] = null;
            }
            if (!$newMember && $grouped[$id]['parameterNames'] !== $argumentContract[3]) {
                $grouped[$id]['parameterNames'] = null;
            }
            if (!$newMember && $grouped[$id]['parameterTypeNames'] !== $argumentContract[4]) {
                $grouped[$id]['parameterTypeNames'] = null;
            }
        }
        if ($memberKind === MemberKind::Method) {
            $returnKind = returnKind($trimmed, $name)->value;
            if ($grouped[$id]['returnKind'] !== $returnKind) {
                $grouped[$id]['returnKind'] = ReturnKind::Unknown->value;
            }
            $returnTypeName = returnTypeName($trimmed, $name);
            if ($grouped[$id]['returnTypeName'] !== $returnTypeName) {
                $grouped[$id]['returnTypeName'] = null;
                $grouped[$id]['returnCollectionElementTypeName'] = null;
                $grouped[$id]['returnObjectShape'] = null;
                $grouped[$id]['returnIndexSignature'] = null;
            }
        }
    }

    $members = [];
    foreach ($grouped as $member) {
        sort($member['signatures']);
        $members[] = [
            'id' => $member['id'],
            'name' => $member['name'],
            'kind' => $member['kind'],
            'static' => $member['static'],
            'minimumArguments' => $member['minimumArguments'],
            'maximumArguments' => $member['maximumArguments'],
            'parameterKinds' => $member['parameterKinds'],
            'parameterNames' => $member['parameterNames'],
            'parameterTypeNames' => $member['parameterTypeNames'],
            'parameterTypeOverrides' => $member['parameterTypeOverrides'],
            'parameterNameOverrides' => $member['parameterNameOverrides'],
            'constructorContractOverride' => $member['constructorContractOverride'],
            'returnKind' => $member['returnKind'],
            'returnTypeName' => $member['returnTypeName'],
            'returnCollectionElementTypeName' => $member['returnCollectionElementTypeName'],
            'returnObjectShape' => $member['returnObjectShape'],
            'returnObjectTypeOverrides' => $member['returnObjectTypeOverrides'],
            'returnIndexSignature' => $member['returnIndexSignature'],
            'propertyTypeName' => $member['propertyTypeName'],
            'propertyOptional' => $member['propertyOptional'],
            'propertyTypeOverride' => $member['propertyTypeOverride'],
            'propertyRuntimeNullable' => $member['propertyRuntimeNullable'],
            'propertyCollectionElementTypeName' => $member['propertyCollectionElementTypeName'],
            'propertyObjectShape' => $member['propertyObjectShape'],
            'propertyIndexSignature' => $member['propertyIndexSignature'],
            'propertyStructureOverride' => $member['propertyStructureOverride'],
            'propertyStructureTypeOverrides' => $member['propertyStructureTypeOverrides'],
            'propertyUnionTypeNames' => $member['propertyUnionTypeNames'],
            'returnTypeOverride' => $member['returnTypeOverride'],
            'runtimeNullable' => $member['runtimeNullable'],
            'signatureHash' => hash('sha256', implode("\0", $member['signatures'])),
            'state' => $member['state'],
            'phpMember' => $member['phpMember'],
        ];
    }
    usort($members, static fn (array $left, array $right): int => $left['id'] <=> $right['id']);

    return $members;
}

function returnTypeName(string $signature, string $name): ?string
{
    $pattern = '/(?:^|\s)(?:public\s+)?(?:static\s+)?'.preg_quote($name, '/').'\??\s*(?::\s*)?\(/';
    if (preg_match($pattern, $signature, $match, PREG_OFFSET_CAPTURE) !== 1) return null;
    $matched = $match[0][0];
    $open = $match[0][1] + strrpos($matched, '(');
    $depth = 1;
    $quote = null;
    $length = strlen($signature);
    for ($index = $open + 1; $index < $length; ++$index) {
        $character = $signature[$index];
        $previous = $index > 0 ? $signature[$index - 1] : '';
        if ($quote !== null) {
            if ($character === $quote && $previous !== '\\') $quote = null;
            continue;
        }
        if ($character === "'" || $character === '"' || $character === '`') {
            $quote = $character;
            continue;
        }
        if ($character === '(') ++$depth;
        if ($character !== ')') continue;
        --$depth;
        if ($depth !== 0) continue;
        $return = substr($signature, $index + 1);
        $return = preg_replace('/\n\s{4}\}\s*$/', '', $return);
        if (!is_string($return)) return null;
        if (preg_match('/^\s*(?::|=>)\s*(.+?)\s*;?\s*$/s', $return, $returnMatch) !== 1) {
            return null;
        }
        $type = trim($returnMatch[1]);
        if (preg_match('/^Promise\s*<(.+)>$/s', $type, $promise) === 1) {
            $type = trim($promise[1]);
        }

        return preg_replace('/\s+/', ' ', $type) ?: $type;
    }

    return null;
}

function propertyTypeName(string $signature, string $name): ?string
{
    if (preg_match(
        '/^(?:public\s+)?(?:readonly\s+)?'.preg_quote($name, '/').'\??\s*:\s*(.+?);?\s*(?:}\s*)?$/s',
        trim($signature),
        $match,
    ) !== 1) {
        return null;
    }
    $type = trim($match[1]);

    return preg_replace('/\s+/', ' ', $type) ?: $type;
}

function propertyOptional(string $signature, string $name): bool
{
    return preg_match(
        '/^(?:public\s+)?(?:readonly\s+)?'.preg_quote($name, '/').'\?\s*:/',
        trim($signature),
    ) === 1;
}

function returnKind(string $signature, string $name): ReturnKind
{
    $type = returnTypeName($signature, $name);
    if ($type === null) return ReturnKind::Unknown;
    $parts = preg_split('/\s*\|\s*/', $type);
    if (is_array($parts)) {
        $valueParts = array_values(array_filter(
            $parts,
            static fn (string $part): bool => $part !== 'null' && $part !== 'undefined',
        ));
        if (count($valueParts) === 1 && count($valueParts) < count($parts)) {
            return match (baseReturnKind($valueParts[0])) {
                ReturnKind::Boolean => ReturnKind::NullableBoolean,
                ReturnKind::Number => ReturnKind::NullableNumber,
                ReturnKind::String => ReturnKind::NullableString,
                ReturnKind::Array => ReturnKind::NullableArray,
                default => ReturnKind::Unknown,
            };
        }
    }

    return baseReturnKind($type);
}

function collectionElementTypeName(?string $type): ?string
{
    if ($type === null) return null;

    $parts = splitTopLevelType($type, '|');
    $elements = [];
    foreach ($parts as $part) {
        $part = trim($part);
        if ($part === '[]' || $part === 'null' || $part === 'undefined') continue;
        if (preg_match('/^Array\s*<(.+)>$/s', $part, $match) === 1
            || preg_match('/^(.+)\[\]$/s', $part, $match) === 1
            || preg_match('/^\[(.+)]$/s', $part, $match) === 1
        ) {
            $elements[] = trim($match[1]);
            continue;
        }

        return null;
    }
    $elements = array_values(array_unique($elements));

    return count($elements) === 1 ? $elements[0] : null;
}

/** @return list<array{name: string, type: string, optional: bool}>|null */
function objectShapeContract(?string $type): ?array
{
    if ($type === null) return null;
    $candidate = collectionElementTypeName($type) ?? $type;
    $parts = splitTopLevelType($candidate, '|');
    $objects = array_values(array_filter(
        array_map('trim', $parts),
        static fn (string $part): bool => str_starts_with($part, '{') && str_ends_with($part, '}'),
    ));
    if (count($objects) !== 1 || str_contains($objects[0], '[key:')) return null;
    $body = trim(substr($objects[0], 1, -1));
    $properties = [];
    foreach (splitTopLevelType($body, ';') as $property) {
        $property = trim($property);
        if ($property === '') continue;
        if (preg_match('/^([A-Za-z_$][A-Za-z0-9_$]*)(\?)?\s*:\s*(.+)$/', $property, $match) !== 1) {
            return null;
        }
        $properties[] = [
            'name' => $match[1],
            'type' => trim($match[3]),
            'optional' => $match[2] === '?',
        ];
    }

    return $properties === [] ? null : $properties;
}

/** @return list<string> */
function splitTopLevelType(string $value, string $separator): array
{
    $segments = [];
    $current = '';
    $round = $square = $curly = $angle = 0;
    $quote = null;
    for ($index = 0, $length = strlen($value); $index < $length; ++$index) {
        $character = $value[$index];
        $previous = $index > 0 ? $value[$index - 1] : '';
        if ($quote !== null) {
            $current .= $character;
            if ($character === $quote && $previous !== '\\') $quote = null;
            continue;
        }
        if ($character === "'" || $character === '"' || $character === '`') {
            $quote = $character;
            $current .= $character;
            continue;
        }
        if ($character === '(') ++$round;
        if ($character === ')') --$round;
        if ($character === '[') ++$square;
        if ($character === ']') --$square;
        if ($character === '{') ++$curly;
        if ($character === '}') --$curly;
        if ($character === '<') ++$angle;
        if ($character === '>') --$angle;
        if ($character === $separator && $round === 0 && $square === 0 && $curly === 0 && $angle === 0) {
            $segments[] = trim($current);
            $current = '';
            continue;
        }
        $current .= $character;
    }
    $segments[] = trim($current);

    return $segments;
}

/** @return list<string>|null */
function unionTypeNames(?string $type): ?array
{
    if ($type === null) return null;
    $parts = array_values(array_filter(
        splitTopLevelType($type, '|'),
        static fn (string $part): bool => $part !== '',
    ));

    return count($parts) > 1 ? $parts : null;
}

/** @return array{keyType: string, valueType: string}|null */
function indexSignatureContract(?string $type): ?array
{
    if ($type === null) return null;
    foreach (splitTopLevelType($type, '|') as $part) {
        if (preg_match(
            '/^\{\s*\[[A-Za-z_$][A-Za-z0-9_$]*:\s*([^]]+)]\s*:\s*(.+)}$/s',
            trim($part),
            $match,
        ) === 1) {
            return ['keyType' => trim($match[1]), 'valueType' => rtrim(trim($match[2]), ';')];
        }
    }

    return null;
}

function baseReturnKind(string $type): ReturnKind
{
    return match (true) {
            $type === 'void' => ReturnKind::Void,
            $type === 'boolean' => ReturnKind::Boolean,
            $type === 'number' => ReturnKind::Number,
            $type === 'string' => ReturnKind::String,
            preg_match('/^(?:Array\s*<.+>|.+\[\])$/s', $type) === 1 => ReturnKind::Array,
            default => ReturnKind::Unknown,
        };
}

/** @return array{int, int, list<int>, list<string>, list<string>}|null */
function argumentContract(string $signature, string $name): ?array
{
    $pattern = '/(?:^|\s)(?:public\s+)?(?:static\s+)?'.preg_quote($name, '/').'\??\s*(?::\s*)?\(/';
    if (preg_match($pattern, $signature, $match, PREG_OFFSET_CAPTURE) !== 1) return null;
    $matched = $match[0][0];
    $matchedOffset = $match[0][1];
    $open = $matchedOffset + strrpos($matched, '(');
    $segments = [];
    $current = '';
    $round = 1;
    $square = 0;
    $curly = 0;
    $angle = 0;
    $quote = null;
    $length = strlen($signature);
    for ($index = $open + 1; $index < $length; ++$index) {
        $character = $signature[$index];
        $previous = $index > 0 ? $signature[$index - 1] : '';
        if ($quote !== null) {
            $current .= $character;
            if ($character === $quote && $previous !== '\\') $quote = null;
            continue;
        }
        if ($character === "'" || $character === '"' || $character === '`') {
            $quote = $character;
            $current .= $character;
            continue;
        }
        if ($character === '(') ++$round;
        if ($character === ')') {
            --$round;
            if ($round === 0) {
                if (trim($current) !== '') $segments[] = trim($current);
                break;
            }
        }
        if ($character === '[') ++$square;
        if ($character === ']') --$square;
        if ($character === '{') ++$curly;
        if ($character === '}') --$curly;
        if ($character === '<') ++$angle;
        if ($character === '>' && $angle > 0) --$angle;
        if ($character === ',' && $round === 1 && $square === 0 && $curly === 0 && $angle === 0) {
            $segments[] = trim($current);
            $current = '';
            continue;
        }
        $current .= $character;
    }
    $minimum = 0;
    $parameterKinds = [];
    $parameterNames = [];
    $parameterTypeNames = [];
    foreach ($segments as $segment) {
        if (preg_match('/^(?:\.\.\.)?[A-Za-z_$][A-Za-z0-9_$]*\?\s*:/', $segment) !== 1
            && preg_match('/^(?:\.\.\.)?[A-Za-z_$][A-Za-z0-9_$]*\s*=/', $segment) !== 1
        ) {
            ++$minimum;
        }
        if (preg_match('/^(?:\.\.\.)?([A-Za-z_$][A-Za-z0-9_$]*)\??\s*:/', $segment, $parameter) === 1) {
            $parameterNames[] = $parameter[1];
        } else {
            $parameterNames[] = '';
        }
        if (preg_match('/^(?:\.\.\.)?[A-Za-z_$][A-Za-z0-9_$]*\??\s*:\s*(.+?)(?:\s*=.+)?$/s', $segment, $type) !== 1) {
            $parameterKinds[] = ParameterKind::Unknown->value;
            $parameterTypeNames[] = '';
            continue;
        }
        $typeName = preg_replace('/\s+/', ' ', trim($type[1]));
        $typeName = is_string($typeName) ? $typeName : trim($type[1]);
        $parameterTypeNames[] = $typeName;
        $parameterKinds[] = parameterKind($typeName)->value;
    }

    return [$minimum, count($segments), $parameterKinds, $parameterNames, $parameterTypeNames];
}

function parameterKind(string $type): ParameterKind
{
    if (str_contains($type, '|')) return ParameterKind::Unknown;

    return match (true) {
        $type === 'boolean' => ParameterKind::Boolean,
        $type === 'number' => ParameterKind::Number,
        $type === 'string' => ParameterKind::String,
        preg_match('/^(?:Array\s*<.+>|.+\[\])$/s', $type) === 1 => ParameterKind::Array,
        default => ParameterKind::Unknown,
    };
}

function signatureHash(string $signature): string
{
    $normalized = preg_replace('/\s+/', ' ', trim($signature));

    return hash('sha256', is_string($normalized) ? $normalized : $signature);
}

/** @return array<string, mixed>|null */
function existingMatrix(): ?array
{
    if (!is_file(MATRIX_PATH)) {
        return null;
    }
    $decoded = json_decode((string) file_get_contents(MATRIX_PATH), true);

    if (!is_array($decoded)) {
        return null;
    }
    $normalized = [];
    foreach ($decoded as $key => $value) {
        if (!is_string($key)) {
            return null;
        }
        $normalized[$key] = $value;
    }

    return $normalized;
}

/**
 * @param list<array{
 *   id: string,
 *   kind: int,
