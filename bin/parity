            '2:parentMessage' => 'parentMessage',
            '2:selectedOptions' => 'selectedOptions',
            '2:voter' => 'voter',
        ],
        'Product' => [
            '2:currency' => 'currency',
            '2:getData' => 'getData',
            '2:id' => 'id',
            '2:name' => 'name',
            '2:price' => 'price',
            '2:quantity' => 'quantity',
            '2:thumbnailUrl' => 'thumbnailUrl',
        ],
        'Reaction' => [
            '2:ack' => 'ack',
            '2:id' => 'id',
            '2:msgId' => 'msgId',
            '2:orphan' => 'orphan',
            '2:orphanReason' => 'orphanReason',
            '2:reaction' => 'reaction',
            '2:read' => 'read',
            '2:senderId' => 'senderId',
            '2:timestamp' => 'timestamp',
        ],
        'SelectedPollOption' => [
            '2:id' => 'id',
            '2:name' => 'name',
        ],
    ];
    $previous = [];
    $existingSymbols = $existing['symbols'] ?? [];
    if (!is_array($existingSymbols)) {
        $existingSymbols = [];
    }
    foreach ($existingSymbols as $symbol) {
        if (is_array($symbol) && is_string($symbol['id'] ?? null)) {
            $previous[$symbol['id']] = $symbol;
        }
    }

    foreach ($symbols as &$symbol) {
        $old = $previous[$symbol['id']] ?? null;
        if (is_array($old)) {
            $symbol['state'] = is_int($old['state'] ?? null) ? $old['state'] : $symbol['state'];
            $symbol['phpSymbol'] = is_string($old['phpSymbol'] ?? null) ? $old['phpSymbol'] : null;
            $oldMembers = [];
            $oldMembersByName = [];
            $members = $old['members'] ?? [];
            if (!is_array($members)) {
                $members = [];
            }
            foreach ($members as $member) {
                if (is_array($member) && is_string($member['id'] ?? null)) {
                    $oldMembers[$member['id']] = $member;
                    if (is_string($member['name'] ?? null)) {
                        $oldMembersByName[$member['name']] = $member;
                    }
                }
            }
            foreach ($symbol['members'] as &$member) {
                $oldMember = $oldMembers[$member['id']] ?? $oldMembersByName[$member['name']] ?? null;
                if (is_array($oldMember)) {
                    $member['state'] = is_int($oldMember['state'] ?? null)
                        ? $oldMember['state']
                        : $member['state'];
                    $member['phpMember'] = is_string($oldMember['phpMember'] ?? null)
                        ? $oldMember['phpMember']
                        : null;
                }
            }
            unset($member);
        }
        if (isset($known[$symbol['id']])) {
            $symbol['state'] = ParityState::InProgress->value;
            $symbol['phpSymbol'] = $known[$symbol['id']];
        }
        foreach ($symbol['members'] as &$member) {
            $phpMember = $knownMembers[$symbol['id']][$member['id']] ?? null;
            if (!is_string($phpMember)) {
                foreach ($knownMembers[$symbol['id']] ?? [] as $knownId => $candidate) {
                    if (substr($knownId, strpos($knownId, ':') + 1) === $member['name']) {
                        $phpMember = $candidate;
                        break;
                    }
                }
            }
            if (is_string($phpMember)) {
                $member['state'] = ParityState::InProgress->value;
                $member['phpMember'] = $phpMember;
            }
        }
        unset($member);
    }
    unset($symbol);
}

/**
 * @param list<array{
 *   id: string,
 *   kind: int,
 *   signatureHash: string,
 *   state: int,
 *   phpSymbol: string|null,
 *   members: list<array{id: string, name: string, kind: int, static: bool, minimumArguments: int|null, maximumArguments: int|null, parameterKinds: list<int>|null, parameterNames: list<string>|null, parameterTypeNames: list<string>|null, parameterTypeOverrides: list<int>, parameterNameOverrides: list<int>, constructorContractOverride: bool, returnKind: int|null, returnTypeName: string|null, returnCollectionElementTypeName: string|null, returnObjectShape: list<array{name: string, type: string, optional: bool}>|null, returnObjectTypeOverrides: list<string>, returnIndexSignature: array{keyType: string, valueType: string}|null, propertyTypeName: string|null, propertyOptional: bool|null, propertyTypeOverride: bool, propertyRuntimeNullable: bool, propertyCollectionElementTypeName: string|null, propertyObjectShape: list<array{name: string, type: string, optional: bool}>|null, propertyIndexSignature: array{keyType: string, valueType: string}|null, propertyStructureOverride: bool, propertyStructureTypeOverrides: list<string>, propertyUnionTypeNames: list<string>|null, returnTypeOverride: bool, runtimeNullable: bool, signatureHash: string, state: int, phpMember: string|null}>
 * }> $symbols
 * @param array<string, list<array{reportSha256: string, check: string}>> $certificationEvidence
 * @param list<array{reportSha256: string, completedAt: string|null, whatsappWeb: string|null, coveredEntries: int}> $certifications
 * @return array<string, mixed>
 */
function matrix(array $symbols, array $certificationEvidence = [], array $certifications = []): array
{
    $memberCount = array_sum(array_map(
        static fn (array $symbol): int => count($symbol['members']),
        $symbols,
    ));

    return [
        'schemaVersion' => 19,
        'baseline' => [
            'package' => 'whatsapp-web.js',
            'version' => BASELINE_VERSION,
            'commit' => BASELINE_COMMIT,
            'contractUrl' => BASELINE_URL,
            'contractSha256' => BASELINE_SHA256,
        ],
        'states' => [
            '1' => 'pending',
            '2' => 'in_progress',
            '3' => 'complete',
            '4' => 'blocked',
        ],
        'declarationKinds' => [
            '1' => 'class',
            '2' => 'interface',
            '3' => 'enum',
            '4' => 'alias',
        ],
        'memberKinds' => [
            '1' => 'method',
            '2' => 'property',
            '3' => 'event',
            '4' => 'enum_case',
        ],
        'returnKinds' => [
            '1' => 'unknown',
            '2' => 'void',
            '3' => 'boolean',
            '4' => 'number',
            '5' => 'string',
            '6' => 'array',
            '7' => 'nullable_boolean',
            '8' => 'nullable_number',
            '9' => 'nullable_string',
            '10' => 'nullable_array',
        ],
        'parameterKinds' => [
            '1' => 'unknown',
            '2' => 'boolean',
            '3' => 'number',
            '4' => 'string',
            '5' => 'array',
        ],
        'summary' => [
            'symbols' => count($symbols),
            'members' => $memberCount,
        ],
        'certificationEvidence' => $certificationEvidence,
        'certifications' => $certifications,
        'symbols' => $symbols,
    ];
}

/** @param array<string, mixed> $value */
function encode(array $value): string
{
    $json = json_encode($value, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR);

    return $json."\n";
}

/** @return array<string, list<array{reportSha256: string, check: string}>> */
function certificationEvidence(mixed $value): array
{
    if ($value === null) return [];
    if (!is_array($value)) fail('API matrix certification evidence is invalid');
    $result = [];
    foreach ($value as $key => $records) {
        if (!is_string($key) || !is_array($records) || !array_is_list($records)) {
            fail('API matrix certification evidence entry is invalid');
        }
        foreach ($records as $record) {
            if (!is_array($record)
                || !is_string($record['reportSha256'] ?? null)
                || !is_string($record['check'] ?? null)
            ) {
                fail('API matrix certification evidence record is invalid');
            }
            $result[$key][] = [
                'reportSha256' => $record['reportSha256'],
                'check' => $record['check'],
            ];
        }
    }

    return $result;
}

/** @return list<array{reportSha256: string, completedAt: string|null, whatsappWeb: string|null, coveredEntries: int}> */
function certifications(mixed $value): array
{
    if ($value === null) return [];
    if (!is_array($value) || !array_is_list($value)) fail('API matrix certifications are invalid');
    $result = [];
    foreach ($value as $record) {
        if (!is_array($record)
            || !is_string($record['reportSha256'] ?? null)
            || !(is_string($record['completedAt'] ?? null) || ($record['completedAt'] ?? null) === null)
            || !(is_string($record['whatsappWeb'] ?? null) || ($record['whatsappWeb'] ?? null) === null)
            || !is_int($record['coveredEntries'] ?? null)
        ) {
            fail('API matrix certification record is invalid');
        }
        $result[] = [
            'reportSha256' => $record['reportSha256'],
            'completedAt' => $record['completedAt'] ?? null,
            'whatsappWeb' => $record['whatsappWeb'] ?? null,
            'coveredEntries' => $record['coveredEntries'],
        ];
    }

    return $result;
}

function refresh(): void
{
    $symbols = extractSymbols(baseline());
    $existing = existingMatrix();
    preserveMappings($symbols, $existing);
    $evidence = certificationEvidence($existing['certificationEvidence'] ?? null);
    $certifications = certifications($existing['certifications'] ?? null);
    $payload = encode(matrix($symbols, $evidence, $certifications));
    $temporary = MATRIX_PATH.'.tmp.'.bin2hex(random_bytes(6));
    if (file_put_contents($temporary, $payload, LOCK_EX) !== strlen($payload)
        || !rename($temporary, MATRIX_PATH)
    ) {
        @unlink($temporary);
        fail('unable to atomically write the API matrix');
    }
    fwrite(STDOUT, sprintf(
        "Generated %d symbols and %d public members in %s.\n",
        count($symbols),
        array_sum(array_map(static fn (array $symbol): int => count($symbol['members']), $symbols)),
        MATRIX_PATH,
    ));
}

function check(bool $allowIncomplete): void
{
    $existing = existingMatrix() ?? fail('API matrix does not exist; run bin/parity refresh');
    $expectedSymbols = extractSymbols(baseline());
    $actualSymbols = $existing['symbols'] ?? null;
    if (!is_array($actualSymbols) || count($actualSymbols) !== count($expectedSymbols)) {
        fail('API matrix symbol count differs from the pinned contract');
    }

    $pending = 0;
    $mapped = 0;
    $certificationEvidence = certificationEvidence($existing['certificationEvidence'] ?? null);
    foreach (array_values($actualSymbols) as $index => $symbol) {
        $expected = $expectedSymbols[$index];
        if (!is_array($symbol)
            || ($symbol['id'] ?? null) !== $expected['id']
            || ($symbol['kind'] ?? null) !== $expected['kind']
            || ($symbol['signatureHash'] ?? null) !== $expected['signatureHash']
        ) {
            fail('API matrix is stale at symbol index '.$index);
        }
        if (($symbol['state'] ?? null) !== ParityState::Complete->value) {
            ++$pending;
        } elseif (!isset($certificationEvidence['symbol:'.$expected['id']])) {
            fail('complete symbol lacks certification evidence: '.$expected['id']);
        }
        if (is_string($symbol['phpSymbol'] ?? null)) {
            ++$mapped;
        }
        $members = $symbol['members'] ?? null;
        if (!is_array($members) || count($members) !== count($expected['members'])) {
            fail('API matrix member count is stale for '.$expected['id']);
        }
        foreach (array_values($members) as $memberIndex => $member) {
            $expectedMember = $expected['members'][$memberIndex];
            if (!is_array($member)
                || ($member['id'] ?? null) !== $expectedMember['id']
                || ($member['static'] ?? null) !== $expectedMember['static']
                || ($member['minimumArguments'] ?? null) !== $expectedMember['minimumArguments']
                || ($member['maximumArguments'] ?? null) !== $expectedMember['maximumArguments']
                || ($member['signatureHash'] ?? null) !== $expectedMember['signatureHash']
            ) {
                fail('API matrix member is stale for '.$expected['id']);
            }
            if (($member['state'] ?? null) !== ParityState::Complete->value) {
                ++$pending;
            } elseif (!isset($certificationEvidence['member:'.$expected['id'].':'.$expectedMember['id']])) {
                fail('complete member lacks certification evidence: '.$expected['id'].'::'.$expectedMember['id']);
            }
            if (is_string($member['phpMember'] ?? null)) {
                ++$mapped;
            }
        }
    }

    validatePhpMappings($actualSymbols);

    if (!$allowIncomplete && $pending > 0) {
        fail(sprintf('%d symbol/member entries are not complete', $pending));
    }
    fwrite(STDOUT, sprintf(
        "API matrix matches whatsapp-web.js %s (%d mapped, %d incomplete entries allowed: %s).\n",
        BASELINE_VERSION,
        $mapped,
        $pending,
        $allowIncomplete ? 'yes' : 'no',
    ));
}

function certify(string $reportPath, bool $dryRun): void
{
    if (!is_file($reportPath) || !is_readable($reportPath)) {
        fail('certification report is not readable');
    }
    $raw = file_get_contents($reportPath);
    if (!is_string($raw)) fail('unable to read certification report');
    try {
        $report = json_decode($raw, true, flags: JSON_THROW_ON_ERROR);
    } catch (JsonException) {
        fail('certification report is not valid JSON');
    }
    if (!is_array($report) || ($report['schemaVersion'] ?? null) !== 2) {
        fail('certification report schema must be 2');
    }
    $baseline = $report['baseline'] ?? null;
    if (!is_array($baseline)
        || ($baseline['version'] ?? null) !== BASELINE_VERSION
        || ($baseline['commit'] ?? null) !== BASELINE_COMMIT
    ) {
        fail('certification report baseline differs from the pinned contract');
    }
    $summary = $report['summary'] ?? null;
    if (!is_array($summary)) fail('certification report summary is invalid');
    $runtime = $report['runtime'] ?? null;
    if (!is_array($runtime)
        || !is_string($runtime['php'] ?? null)
        || version_compare($runtime['php'], '8.5.0', '<')
        || !is_string($runtime['whatsappWeb'] ?? null)
        || $runtime['whatsappWeb'] === ''
        || !is_string($runtime['completedAt'] ?? null)
        || strtotime($runtime['completedAt']) === false
    ) {
        fail('certification runtime evidence is invalid or predates PHP 8.5');
    }
    $existing = existingMatrix() ?? fail('API matrix does not exist; run bin/parity refresh');
    $symbols = $existing['symbols'] ?? null;
    if (!is_array($symbols)) fail('API matrix symbols are invalid');

    $valid = [];
    foreach ($symbols as $symbol) {
        if (!is_array($symbol) || !is_string($symbol['id'] ?? null)) continue;
        $valid['symbol:'.$symbol['id']] = true;
        $members = $symbol['members'] ?? null;
        if (!is_array($members)) fail('API matrix symbol members are invalid');
        foreach ($members as $member) {
            if (!is_array($member) || !is_string($member['id'] ?? null)) continue;
            $valid['member:'.$symbol['id'].':'.$member['id']] = true;
        }
    }
    $digest = hash('sha256', $raw);
    $newEvidence = [];
    $checks = $report['checks'] ?? null;
    if (!is_array($checks)) fail('certification report checks are invalid');
    $statusCounts = [1 => 0, 2 => 0, 3 => 0];
    foreach ($checks as $check) {
        if (!is_array($check) || !is_string($check['name'] ?? null) || !is_int($check['status'] ?? null)) {
            fail('certification report contains an invalid check');
        }
        if (!isset($statusCounts[$check['status']])) {
            fail('certification report contains an unknown check status');
        }
        ++$statusCounts[$check['status']];
        $covers = $check['covers'] ?? [];
        if (!is_array($covers)) fail('certification check coverage is invalid');
        if ($check['status'] !== 1) {
            if ($covers !== []) fail('non-passing certification checks cannot provide coverage');
            continue;
        }
        foreach ($covers as $key) {
            if (!is_string($key) || !isset($valid[$key])) {
                fail('certification report references an unknown matrix entry: '.(is_string($key) ? $key : 'non-string'));
            }
            $newEvidence[$key][] = ['reportSha256' => $digest, 'check' => $check['name']];
        }
    }
    if (($summary['passed'] ?? null) !== $statusCounts[1]
        || ($summary['failed'] ?? null) !== $statusCounts[2]
        || ($summary['skipped'] ?? null) !== $statusCounts[3]
    ) {
        fail('certification report summary does not match its checks');
    }
    if ($statusCounts[2] !== 0) fail('certification report contains failed checks');
    if ($newEvidence === []) fail('certification report contains no passing coverage');

    $evidence = certificationEvidence($existing['certificationEvidence'] ?? null);
    foreach ($newEvidence as $key => $records) {
        $evidence[$key] = $records;
    }
    foreach ($symbols as &$symbol) {
        if (!is_array($symbol) || !is_string($symbol['id'] ?? null)) continue;
        $members = $symbol['members'] ?? null;
        if (!is_array($members)) fail('API matrix symbol members are invalid');
        foreach ($members as &$member) {
            if (!is_array($member) || !is_string($member['id'] ?? null)) continue;
            if (isset($evidence['member:'.$symbol['id'].':'.$member['id']])) {
                $member['state'] = ParityState::Complete->value;
            }
        }
        unset($member);
        $symbol['members'] = $members;
        $allMembersComplete = true;
        foreach ($members as $member) {
            if (!is_array($member) || ($member['state'] ?? null) !== ParityState::Complete->value) {
                $allMembersComplete = false;
                break;
            }
        }
        if (isset($evidence['symbol:'.$symbol['id']]) && $allMembersComplete) {
            $symbol['state'] = ParityState::Complete->value;
        }
    }
    unset($symbol);
    $certifications = certifications($existing['certifications'] ?? null);
    $certifications[] = [
        'reportSha256' => $digest,
        'completedAt' => $runtime['completedAt'],
        'whatsappWeb' => $runtime['whatsappWeb'],
        'coveredEntries' => count($newEvidence),
    ];
    if ($dryRun) {
        fwrite(STDOUT, sprintf(
            "Validated %d certified matrix entries from report %s without modifying the matrix.\n",
            count($newEvidence),
            $digest,
        ));
        return;
    }
    $existing['symbols'] = $symbols;
    $existing['certificationEvidence'] = $evidence;
    $existing['certifications'] = $certifications;
    $payload = encode($existing);
    $temporary = MATRIX_PATH.'.tmp.'.bin2hex(random_bytes(6));
    if (file_put_contents($temporary, $payload, LOCK_EX) !== strlen($payload)
        || !rename($temporary, MATRIX_PATH)
    ) {
        @unlink($temporary);
        fail('unable to atomically record certification evidence');
    }
    fwrite(STDOUT, sprintf("Recorded %d certified matrix entries from report %s.\n", count($newEvidence), $digest));
}

/** @param array<mixed> $symbols */
function validatePhpMappings(array $symbols): void
{
    $autoload = __DIR__.'/../vendor/autoload.php';
    if (!is_file($autoload)) {
        fail('Composer autoload is required to validate PHP mappings');
    }
    require_once $autoload;

    $phpSymbolsByTypeScript = [];
    foreach ($symbols as $symbol) {
        if (is_array($symbol)
            && is_string($symbol['id'] ?? null)
            && is_string($symbol['phpSymbol'] ?? null)
        ) {
            $phpSymbolsByTypeScript[$symbol['id']] = $symbol['phpSymbol'];
        }
    }

    foreach ($symbols as $symbol) {
        if (!is_array($symbol) || !is_string($symbol['phpSymbol'] ?? null)) {
            continue;
        }
        $phpSymbol = $symbol['phpSymbol'];
        if (!class_exists($phpSymbol) && !interface_exists($phpSymbol) && !enum_exists($phpSymbol)) {
            fail('mapped PHP symbol does not exist: '.$phpSymbol);
        }
        $reflection = new ReflectionClass($phpSymbol);
        $members = $symbol['members'] ?? [];
        if (!is_array($members)) {
            continue;
        }
        foreach ($members as $member) {
            if (!is_array($member) || !is_string($member['phpMember'] ?? null)) {
                continue;
            }
            $phpMember = preg_replace('/\(.*/', '', $member['phpMember']);
            if (!is_string($phpMember) || $phpMember === '') {
                fail('mapped PHP member is invalid on '.$phpSymbol);
            }
            if (!$reflection->hasMethod($phpMember)
                && !$reflection->hasProperty($phpMember)
                && !$reflection->hasConstant($phpMember)
            ) {
                fail('mapped PHP member does not exist: '.$phpSymbol.'::'.$phpMember);
            }
            $expectsStatic = ($member['static'] ?? false) === true;
            $method = $reflection->hasMethod($phpMember) ? $reflection->getMethod($phpMember) : null;
            $property = $reflection->hasProperty($phpMember) ? $reflection->getProperty($phpMember) : null;
            $constant = $reflection->getReflectionConstant($phpMember);
            $publicMethod = $method instanceof ReflectionMethod
                && $method->isPublic()
                && $method->isStatic() === $expectsStatic;
            $publicProperty = !$expectsStatic
                && $property instanceof ReflectionProperty
                && $property->isPublic();
            $publicConstant = !$expectsStatic
                && $constant instanceof ReflectionClassConstant
                && $constant->isPublic();
            if (!$publicMethod && !$publicProperty && !$publicConstant) {
                fail('mapped PHP member is not public with matching staticness: '.$phpSymbol.'::'.$phpMember);
            }
            if ($publicProperty && ($member['propertyTypeOverride'] ?? false) !== true) {
                $propertyTypeName = $member['propertyTypeName'] ?? null;
                $propertyOptional = ($member['propertyOptional'] ?? false) === true;
                if (is_string($propertyTypeName)
                    && !propertyTypeContractMatches(
                        $propertyTypeName,
                        $propertyOptional,
                        $property->getType(),
                        $phpSymbolsByTypeScript,
                        ($member['propertyRuntimeNullable'] ?? false) === true,
                    )
                ) {
                    fail(sprintf(
                        'mapped PHP property has incompatible type (%s%s): %s::%s',
                        $propertyTypeName,
                        $propertyOptional ? ', optional' : '',
                        $phpSymbol,
                        $phpMember,
                    ));
                }
                $propertyUnionTypeNames = $member['propertyUnionTypeNames'] ?? null;
                $unionTypes = [];
                if (is_array($propertyUnionTypeNames)) {
                    foreach ($propertyUnionTypeNames as $unionType) {
                        if (is_string($unionType)) $unionTypes[] = $unionType;
                    }
                }
                if ($unionTypes !== []
                    && !propertyUnionContractMatches(
                        $unionTypes,
                        $propertyOptional,
                        $property->getType(),
                        $phpSymbolsByTypeScript,
                    )
                ) {
                    fail(sprintf(
                        'mapped PHP property has incompatible union (%s): %s::%s',
                        implode(' | ', $unionTypes),
                        $phpSymbol,
                        $phpMember,
                    ));
                }
            }
            if ($publicProperty && ($member['propertyStructureOverride'] ?? false) !== true) {
                $propertyCollectionElementTypeName = $member['propertyCollectionElementTypeName'] ?? null;
                if (is_string($propertyCollectionElementTypeName)) {
                    $expectedElement = mappedParameterType(
                        $propertyCollectionElementTypeName,
                        $phpSymbolsByTypeScript,
                    );
                    if ($expectedElement !== null
                        && !phpDocTypeMatchesClass(propertyPhpDocListElementType($property), $expectedElement)
                    ) {
                        fail(sprintf(
                            'mapped PHP property has incompatible collection element (%s): %s::%s',
                            $propertyCollectionElementTypeName,
                            $phpSymbol,
                            $phpMember,
                        ));
                    }
                }
                $propertyObjectShape = $member['propertyObjectShape'] ?? null;
                if (is_array($propertyObjectShape)) {
                    $shapeClass = propertyObjectShapeClass(
                        $property,
                        is_string($propertyCollectionElementTypeName),
                    );
                    $phpDocShape = $shapeClass === null ? propertyPhpDocArrayShape($property) : [];
                    if (($shapeClass === null || !class_exists($shapeClass)) && $phpDocShape === []) {
                        fail(sprintf('mapped PHP property lacks a typed object-shape target: %s::%s', $phpSymbol, $phpMember));
                    }
                    $shapeReflection = $shapeClass !== null && class_exists($shapeClass)
                        ? new ReflectionClass($shapeClass)
                        : null;
                    $structureTypeOverrides = $member['propertyStructureTypeOverrides'] ?? [];
                    if (!is_array($structureTypeOverrides)) $structureTypeOverrides = [];
                    foreach ($propertyObjectShape as $shapeMember) {
                        if (!is_array($shapeMember)
                            || !is_string($shapeMember['name'] ?? null)
                            || !is_string($shapeMember['type'] ?? null)
                        ) continue;
                        $shapeName = $shapeMember['name'];
                        $validShapeMember = $shapeReflection instanceof ReflectionClass
                            ? $shapeReflection->hasProperty($shapeName)
                                && $shapeReflection->getProperty($shapeName)->isPublic()
                                && (in_array($shapeName, $structureTypeOverrides, true)
                                    || propertyTypeContractMatches(
                                        $shapeMember['type'],
                                        ($shapeMember['optional'] ?? false) === true,
                                        $shapeReflection->getProperty($shapeName)->getType(),
                                        $phpSymbolsByTypeScript,
                                        false,
                                    ))
                            : isset($phpDocShape[$shapeName])
                                && (in_array($shapeName, $structureTypeOverrides, true)
                                    || typescriptTypeMatchesPhpDoc(
                                        $shapeMember['type'],
                                        $phpDocShape[$shapeName],
                                        $phpSymbolsByTypeScript,
                                    ));
                        if (!$validShapeMember) {
                            fail(sprintf(
                                'mapped PHP property object-shape differs at %s: %s::%s',
                                $shapeName,
                                $phpSymbol,
                                $phpMember,
                            ));
                        }
                    }
                }
                $propertyIndexSignature = $member['propertyIndexSignature'] ?? null;
                if (is_array($propertyIndexSignature)
                    && is_string($propertyIndexSignature['keyType'] ?? null)
                    && is_string($propertyIndexSignature['valueType'] ?? null)
                ) {
                    $map = propertyPhpDocMapTypes($property);
                    $valueMatches = $map !== null && typescriptTypeMatchesPhpDoc(
                        $propertyIndexSignature['valueType'],
                        $map['valueType'],
                        $phpSymbolsByTypeScript,
                    );
                    if (!$valueMatches && $map !== null) {
                        $valueShape = objectShapeContract($propertyIndexSignature['valueType']);
                        $valueClass = namespacedPhpDocClass($property, $map['valueType']);
                        $valueMatches = is_array($valueShape)
                            && $valueClass !== null
                            && class_exists($valueClass)
                            && objectShapeMatchesReflection(
                                $valueShape,
                                new ReflectionClass($valueClass),
                                $phpSymbolsByTypeScript,
                            );
                    }
                    if ($map === null
                        || !typescriptTypeMatchesPhpDoc(
                            $propertyIndexSignature['keyType'],
                            $map['keyType'],
                            $phpSymbolsByTypeScript,
                        )
                        || !$valueMatches
                    ) {
                        fail(sprintf('mapped PHP property has incompatible indexed map: %s::%s', $phpSymbol, $phpMember));
                    }
                }
            }
            if ($publicMethod && ($member['constructorContractOverride'] ?? false) !== true) {
                $minimumArguments = $member['minimumArguments'] ?? null;
                $maximumArguments = $member['maximumArguments'] ?? null;
                if (is_int($minimumArguments)
                    && $method->getNumberOfRequiredParameters() > $minimumArguments
                ) {
                    fail('mapped PHP method requires too many arguments: '.$phpSymbol.'::'.$phpMember);
                }
                if (is_int($maximumArguments)
                    && !$method->isVariadic()
                    && $method->getNumberOfParameters() < $maximumArguments
                ) {
                    fail('mapped PHP method accepts too few arguments: '.$phpSymbol.'::'.$phpMember);
                }
                $parameterKinds = $member['parameterKinds'] ?? null;
                $parameterNames = $member['parameterNames'] ?? null;
                $parameterTypeNames = $member['parameterTypeNames'] ?? null;
                $parameterTypeOverrides = $member['parameterTypeOverrides'] ?? [];
                if (!is_array($parameterTypeOverrides)) $parameterTypeOverrides = [];
                if (is_array($parameterNames)) {
                    $phpParameters = $method->getParameters();
                    $parameterNameOverrides = $member['parameterNameOverrides'] ?? [];
                    if (!is_array($parameterNameOverrides)) $parameterNameOverrides = [];
                    foreach ($parameterNames as $position => $parameterName) {
                        if (!is_int($position) || !is_string($parameterName) || $parameterName === '') continue;
                        if (in_array($position + 1, $parameterNameOverrides, true)) continue;
                        $parameter = $phpParameters[$position] ?? ($method->isVariadic() ? end($phpParameters) : null);
                        if (!$parameter instanceof ReflectionParameter || $parameter->getName() !== $parameterName) {
                            fail(sprintf(
                                'mapped PHP method has incompatible parameter name %d (%s): %s::%s',
                                $position + 1,
                                $parameterName,
                                $phpSymbol,
                                $phpMember,
                            ));
                        }
                    }
                }
                if (is_array($parameterTypeNames)) {
                    $phpParameters = $method->getParameters();
                    foreach ($parameterTypeNames as $position => $parameterTypeName) {
                        if (!is_int($position) || !is_string($parameterTypeName)) continue;
                        if (in_array($position + 1, $parameterTypeOverrides, true)) continue;
                        $expectedPhpType = mappedParameterType($parameterTypeName, $phpSymbolsByTypeScript);
                        if ($expectedPhpType === null) continue;
                        $parameter = $phpParameters[$position] ?? ($method->isVariadic() ? end($phpParameters) : null);
                        $actualTypes = $parameter instanceof ReflectionParameter
                            ? array_values(array_diff(reflectionReturnNames($parameter->getType()), ['null']))
                            : [];
                        if ($actualTypes !== [$expectedPhpType]) {
                            fail(sprintf(
                                'mapped PHP method has incompatible object parameter %d (%s): %s::%s',
                                $position + 1,
                                $parameterTypeName,
                                $phpSymbol,
                                $phpMember,
                            ));
                        }
                    }
                }
                if (is_array($parameterKinds)) {
                    $phpParameters = $method->getParameters();
                    foreach ($parameterKinds as $position => $parameterKindValue) {
                        if (!is_int($position) || !is_int($parameterKindValue)) continue;
                        if (in_array($position + 1, $parameterTypeOverrides, true)) continue;
                        $parameterKind = ParameterKind::tryFrom($parameterKindValue);
                        if ($parameterKind === null || $parameterKind === ParameterKind::Unknown) continue;
                        $parameter = $phpParameters[$position] ?? ($method->isVariadic() ? end($phpParameters) : null);
                        if (!$parameter instanceof ReflectionParameter
                            || !parameterTypeMatches($parameterKind, $parameter->getType())
                        ) {
                            fail(sprintf(
                                'mapped PHP method has incompatible %s parameter %d: %s::%s',
                                strtolower($parameterKind->name),
                                $position + 1,
                                $phpSymbol,
                                $phpMember,
                            ));
                        }
                    }
                }
                $returnTypeName = $member['returnTypeName'] ?? null;
                if (is_string($returnTypeName) && ($member['returnTypeOverride'] ?? false) !== true) {
                    $expectedPhpReturn = mappedParameterType($returnTypeName, $phpSymbolsByTypeScript);
                    if ($expectedPhpReturn !== null) {
                        $actualPhpReturns = array_values(array_diff(
                            reflectionReturnNames($method->getReturnType()),
                            ['null'],
                        ));
                        $parent = $reflection->getParentClass();
                        $parentName = $parent === false ? 'parent' : $parent->getName();
                        $actualPhpReturns = array_map(
                            static fn (string $type): string => match ($type) {
                                'self', 'static' => $phpSymbol,
                                'parent' => $parentName,
                                default => $type,
                            },
                            $actualPhpReturns,
                        );
                        if ($actualPhpReturns !== [$expectedPhpReturn]) {
                            fail(sprintf(
                                'mapped PHP method has incompatible object return (%s): %s::%s',
                                $returnTypeName,
                                $phpSymbol,
                                $phpMember,
                            ));
                        }
                    }
                }
                $returnCollectionElementTypeName = $member['returnCollectionElementTypeName'] ?? null;
                if (is_string($returnCollectionElementTypeName)) {
                    $expectedPhpElement = mappedParameterType(
                        $returnCollectionElementTypeName,
                        $phpSymbolsByTypeScript,
                    );
                    if ($expectedPhpElement !== null) {
                        $actualPhpElement = phpDocListElementType($method);
                        $separator = strrpos($expectedPhpElement, '\\');
                        $expectedShortName = $separator === false
                            ? $expectedPhpElement
                            : substr($expectedPhpElement, $separator + 1);
                        if ($actualPhpElement !== $expectedPhpElement
                            && $actualPhpElement !== $expectedShortName
                        ) {
                            fail(sprintf(
                                'mapped PHP method has incompatible collection element (%s): %s::%s',
                                $returnCollectionElementTypeName,
                                $phpSymbol,
                                $phpMember,
                            ));
                        }
                    }
                }
                $returnObjectShape = $member['returnObjectShape'] ?? null;
                if (is_array($returnObjectShape)) {
                    $shapePropertyNames = [];
                    $shapeProperties = [];
                    foreach ($returnObjectShape as $shapeProperty) {
                        if (!is_array($shapeProperty)
                            || !is_string($shapeProperty['name'] ?? null)
                            || !is_string($shapeProperty['type'] ?? null)
                            || !is_bool($shapeProperty['optional'] ?? null)
                        ) continue;
                        $shapePropertyNames[] = $shapeProperty['name'];
                        $shapeProperties[] = $shapeProperty;
                    }
                    $shapeTypeOverrides = $member['returnObjectTypeOverrides'] ?? [];
                    if (!is_array($shapeTypeOverrides)) $shapeTypeOverrides = [];
                    $shapeClass = objectShapeReturnClass($method, is_string($returnCollectionElementTypeName));
                    if ($shapeClass !== null && class_exists($shapeClass)) {
                        $shapeReflection = new ReflectionClass($shapeClass);
                        foreach ($shapeProperties as $shapeProperty) {
                            $shapePropertyName = $shapeProperty['name'];
                            if (!$shapeReflection->hasProperty($shapePropertyName)
                                || !$shapeReflection->getProperty($shapePropertyName)->isPublic()
                            ) {
                                fail(sprintf(
                                    'mapped PHP object return lacks public shape property %s: %s::%s',
                                    $shapePropertyName,
                                    $phpSymbol,
                                    $phpMember,
                                ));
                            }
                            if (!in_array($shapePropertyName, $shapeTypeOverrides, true)
                                && !typescriptTypeMatchesReflection(
                                    $shapeProperty['type'],
                                    $shapeReflection->getProperty($shapePropertyName)->getType(),
                                    $phpSymbolsByTypeScript,
                                )
                            ) {
                                fail(sprintf(
                                    'mapped PHP object return has incompatible shape property type %s (%s): %s::%s',
                                    $shapePropertyName,
                                    $shapeProperty['type'],
                                    $phpSymbol,
                                    $phpMember,
                                ));
                            }
                        }
                    } else {
                        $phpDocShape = phpDocArrayShape($method);
                        foreach ($shapeProperties as $shapeProperty) {
                            $actualShapeProperty = $phpDocShape[$shapeProperty['name']] ?? null;
                            if (!is_array($actualShapeProperty)
                                || $actualShapeProperty['optional'] !== $shapeProperty['optional']
                                || (!in_array($shapeProperty['name'], $shapeTypeOverrides, true)
                                    && !typescriptTypeMatchesPhpDoc(
                                        $shapeProperty['type'],
                                        $actualShapeProperty['type'],
                                        $phpSymbolsByTypeScript,
                                    ))
                            ) {
                                fail(sprintf(
                                    'mapped PHP array return has incompatible shape property %s: %s::%s',
                                    $shapeProperty['name'],
                                    $phpSymbol,
                                    $phpMember,
                                ));
                            }
                        }
                    }
                }
                $returnIndexSignature = $member['returnIndexSignature'] ?? null;
                if (is_array($returnIndexSignature)
                    && is_string($returnIndexSignature['keyType'] ?? null)
                    && is_string($returnIndexSignature['valueType'] ?? null)
                ) {
                    $phpDocMap = phpDocMapTypes($method);
                    if ($phpDocMap === null
                        || !typescriptTypeMatchesPhpDoc(
                            $returnIndexSignature['keyType'],
                            $phpDocMap['keyType'],
                            $phpSymbolsByTypeScript,
                        )
                        || !typescriptTypeMatchesPhpDoc(
                            $returnIndexSignature['valueType'],
                            $phpDocMap['valueType'],
                            $phpSymbolsByTypeScript,
                        )
                    ) {
                        fail(sprintf(
                            'mapped PHP method has incompatible indexed return map: %s::%s',
                            $phpSymbol,
                            $phpMember,
                        ));
                    }
                }
                $returnKind = ReturnKind::tryFrom(is_int($member['returnKind'] ?? null) ? $member['returnKind'] : 0)
                    ?? ReturnKind::Unknown;
                if ($returnKind !== ReturnKind::Unknown) {
                    $returnType = $method->getReturnType();
                    $phpReturns = reflectionReturnNames($returnType);
                    $allowsNull = in_array('null', $phpReturns, true);
                    $runtimeNullable = ($member['runtimeNullable'] ?? false) === true;
                    $validReturn = match ($returnKind) {
                        ReturnKind::Void => $phpReturns === ['void'],
                        ReturnKind::Boolean => $allowsNull === $runtimeNullable
                            && array_values(array_diff($phpReturns, ['null'])) === ['bool'],
                        ReturnKind::Number => $allowsNull === $runtimeNullable
                            && $phpReturns !== []
                            && array_diff($phpReturns, ['int', 'float', 'null']) === []
                            && (in_array('int', $phpReturns, true) || in_array('float', $phpReturns, true)),
                        ReturnKind::String => $allowsNull === $runtimeNullable
                            && array_values(array_diff($phpReturns, ['null'])) === ['string'],
                        ReturnKind::Array => $allowsNull === $runtimeNullable
                            && array_values(array_diff($phpReturns, ['null'])) === ['array'],
                        ReturnKind::NullableBoolean => $allowsNull && in_array('bool', $phpReturns, true),
                        ReturnKind::NullableNumber => $allowsNull
                            && array_diff($phpReturns, ['int', 'float', 'null']) === []
                            && (in_array('int', $phpReturns, true) || in_array('float', $phpReturns, true)),
                        ReturnKind::NullableString => $allowsNull && in_array('string', $phpReturns, true),
                        ReturnKind::NullableArray => $allowsNull && in_array('array', $phpReturns, true),
                    };
                    if (!$validReturn) {
                        fail(sprintf(
                            'mapped PHP method has incompatible %s return: %s::%s',
                            strtolower($returnKind->name),
                            $phpSymbol,
                            $phpMember,
                        ));
                    }
                }
            }
        }
    }
}

function phpDocListElementType(ReflectionMethod $method): ?string
{
    $documentation = $method->getDocComment();
    if (!is_string($documentation)
        || preg_match('/@return\s+list<([^>]+)>/', $documentation, $match) !== 1
    ) {
        return null;
    }

    return ltrim(trim($match[1]), '\\');
}

function propertyPhpDocListElementType(ReflectionProperty $property): ?string
{
    $type = propertyPhpDocType($property);
    if ($type === null || preg_match('/^list<([^>]+)>$/', $type, $match) !== 1) return null;

    return ltrim(trim($match[1]), '\\');
}

function propertyPhpDocType(ReflectionProperty $property): ?string
{
    $documentation = $property->getDocComment();
    if (is_string($documentation)
        && preg_match('/@var\s+([^\r\n*]+)/', $documentation, $match) === 1
    ) {
        return trim($match[1]);
    }
    $constructor = $property->getDeclaringClass()->getConstructor();
    $documentation = $constructor?->getDocComment();
    if (!is_string($documentation)) return null;
    if (preg_match(
        '/@param\s+([^\s*]+)\s+\$'.preg_quote($property->getName(), '/').'\b/',
        $documentation,
        $match,
    ) !== 1) {
        return null;
    }

    return trim($match[1]);
}

function phpDocTypeMatchesClass(?string $phpDocType, string $expectedClass): bool
{
    if ($phpDocType === null) return false;
    $phpDocType = ltrim($phpDocType, '\\');
    $separator = strrpos($expectedClass, '\\');
    $shortName = $separator === false ? $expectedClass : substr($expectedClass, $separator + 1);

    return $phpDocType === $expectedClass || $phpDocType === $shortName;
}

function propertyObjectShapeClass(ReflectionProperty $property, bool $collection): ?string
{
    $candidate = $collection
        ? propertyPhpDocListElementType($property)
        : array_values(array_diff(reflectionReturnNames($property->getType()), ['null']))[0] ?? null;
    if (!is_string($candidate) || in_array($candidate, ['array', 'bool', 'float', 'int', 'mixed', 'string'], true)) {
        return null;
    }
    if (str_contains($candidate, '\\')) return $candidate;
    $namespace = $property->getDeclaringClass()->getNamespaceName();

    return $namespace === '' ? $candidate : $namespace.'\\'.$candidate;
}

function namespacedPhpDocClass(ReflectionProperty $property, string $type): ?string
{
    $type = ltrim(trim($type), '\\');
    if (preg_match('/^[A-Za-z_][A-Za-z0-9_\\\\]*$/', $type) !== 1) return null;
    if (str_contains($type, '\\')) return $type;
    $namespace = $property->getDeclaringClass()->getNamespaceName();

    return $namespace === '' ? $type : $namespace.'\\'.$type;
}

/**
 * @param list<array{name: string, type: string, optional: bool}> $shape
 * @param ReflectionClass<object> $reflection
 * @param array<string, string> $phpSymbolsByTypeScript
 */
function objectShapeMatchesReflection(array $shape, ReflectionClass $reflection, array $phpSymbolsByTypeScript): bool
{
    foreach ($shape as $member) {
        $name = $member['name'];
        if (!$reflection->hasProperty($name)
            || !$reflection->getProperty($name)->isPublic()
            || !propertyTypeContractMatches(
                $member['type'],
                $member['optional'],
                $reflection->getProperty($name)->getType(),
                $phpSymbolsByTypeScript,
                false,
            )
        ) {
            return false;
        }
    }

    return true;
}

/** @return array{keyType: string, valueType: string}|null */
function propertyPhpDocMapTypes(ReflectionProperty $property): ?array
{
    $type = propertyPhpDocType($property);
    if ($type === null || preg_match('/^array<\s*([^,]+),\s*([^>]+)>$/', $type, $match) !== 1) {
        return null;
    }

    return ['keyType' => trim($match[1]), 'valueType' => trim($match[2])];
}

/** @return array<string, string> */
function propertyPhpDocArrayShape(ReflectionProperty $property): array
{
    $type = propertyPhpDocType($property);
    if ($type === null || preg_match('/^array\{(.+)}$/', $type, $match) !== 1) return [];
    $shape = [];
    foreach (explode(',', $match[1]) as $member) {
        if (preg_match('/^\s*([A-Za-z_$][A-Za-z0-9_$]*)\??\s*:\s*(.+)\s*$/', $member, $parts) !== 1) {
            return [];
        }
        $shape[$parts[1]] = trim($parts[2]);
    }

    return $shape;
}

function objectShapeReturnClass(ReflectionMethod $method, bool $collection): ?string
{
    $candidate = $collection
        ? phpDocListElementType($method)
        : array_values(array_diff(reflectionReturnNames($method->getReturnType()), ['null']))[0] ?? null;
    if (!is_string($candidate) || in_array($candidate, ['array', 'bool', 'float', 'int', 'mixed', 'string'], true)) {
        return null;
    }
    if (str_contains($candidate, '\\')) return $candidate;
    $namespace = $method->getDeclaringClass()->getNamespaceName();

    return $namespace === '' ? $candidate : $namespace.'\\'.$candidate;
}

/** @return array<string, array{type: string, optional: bool}> */
function phpDocArrayShape(ReflectionMethod $method): array
{
    $documentation = $method->getDocComment();
    if (!is_string($documentation)
        || preg_match('/@return\s+array\{([^}]+)}/', $documentation, $match) !== 1
    ) {
        return [];
    }
    $properties = [];
    foreach (explode(',', $match[1]) as $property) {
        if (preg_match('/^\s*([A-Za-z_$][A-Za-z0-9_$]*)(\?)?\s*:\s*([^,]+)\s*$/', $property, $parts) !== 1) {
            continue;
        }
        $properties[$parts[1]] = ['type' => trim($parts[3]), 'optional' => $parts[2] === '?'];
    }

    return $properties;
}

/** @return array{keyType: string, valueType: string}|null */
function phpDocMapTypes(ReflectionMethod $method): ?array
{
    $documentation = $method->getDocComment();
    if (!is_string($documentation)
        || preg_match('/@return\s+array<\s*([^,]+),\s*([^>]+)>/', $documentation, $match) !== 1
    ) {
        return null;
    }

    return ['keyType' => trim($match[1]), 'valueType' => trim($match[2])];
}

/** @param array<string, string> $phpSymbolsByTypeScript */
function typescriptTypeMatchesReflection(
    string $type,
    ?ReflectionType $reflectionType,
    array $phpSymbolsByTypeScript,
): bool {
    $actual = array_values(array_diff(reflectionReturnNames($reflectionType), ['null']));
    $expectedClass = mappedParameterType($type, $phpSymbolsByTypeScript);
    if ($expectedClass !== null) return $actual === [$expectedClass];

    return match ($type) {
        'any' => $actual === ['mixed'],
        'boolean' => $actual === ['bool'],
        'number' => $actual !== [] && array_diff($actual, ['int', 'float']) === [],
        'string' => $actual === ['string'],
        default => false,
    };
}

/** @param array<string, string> $phpSymbolsByTypeScript */
function propertyTypeContractMatches(
    string $type,
    bool $optional,
    ?ReflectionType $reflectionType,
    array $phpSymbolsByTypeScript,
    bool $runtimeNullable,
): bool {
    $parts = preg_split('/\s*\|\s*/', $type);
    if (!is_array($parts)) return true;
    $nullable = $runtimeNullable || in_array('null', $parts, true) || in_array('undefined', $parts, true);
    $valueTypes = array_values(array_filter(
        $parts,
        static fn (string $part): bool => $part !== 'null' && $part !== 'undefined',
    ));
    if (count($valueTypes) !== 1) return true;
    $valueType = trim($valueTypes[0]);
    $actual = reflectionReturnNames($reflectionType);
    $actualNullable = in_array('null', $actual, true);
    $actualValues = array_values(array_diff($actual, ['null']));
    $expectedClass = mappedParameterType($valueType, $phpSymbolsByTypeScript);
    $verifiable = true;
    $typeMatches = match (true) {
        $expectedClass !== null => count($actualValues) === 1
            && ($actualValues[0] === $expectedClass || is_a($actualValues[0], $expectedClass, true)),
        $valueType === 'boolean' => $actualValues === ['bool'],
        $valueType === 'number' => $actualValues !== [] && array_diff($actualValues, ['int', 'float']) === [],
        $valueType === 'string' => $actualValues === ['string'],
        baseReturnKind($valueType) === ReturnKind::Array => $actualValues === ['array'],
        default => $verifiable = false,
    };

    return !$verifiable || ($typeMatches && ($optional || $nullable === $actualNullable));
}

/**
 * @param list<string> $types
 * @param array<string, string> $phpSymbolsByTypeScript
 */
function propertyUnionContractMatches(
    array $types,
    bool $optional,
    ?ReflectionType $reflectionType,
    array $phpSymbolsByTypeScript,
): bool {
    $expected = [];
    foreach ($types as $type) {
        $type = trim($type);
        $mapped = mappedParameterType($type, $phpSymbolsByTypeScript);
        $category = match (true) {
            $type === 'null' || $type === 'undefined' => 'null',
            $type === 'boolean' => 'bool',
            $type === 'number' => 'number',
            $type === 'string' => 'string',
            $type === 'any' => 'mixed',
            $mapped !== null => 'class:'.$mapped,
            baseReturnKind($type) === ReturnKind::Array => 'array',
            (str_starts_with($type, '{') && str_ends_with($type, '}')) || $type === 'Object' || $type === 'object' => 'object',
            default => null,
        };
        if ($category === null) return true;
        $expected[$category] = false;
    }
    if ($optional) $expected['null'] ??= false;

    foreach (reflectionReturnNames($reflectionType) as $actual) {
        $category = match (true) {
            $actual === 'null' => 'null',
            $actual === 'bool' => 'bool',
            $actual === 'int' || $actual === 'float' => 'number',
            $actual === 'string' => 'string',
            $actual === 'array' => 'array',
            $actual === 'mixed' => 'mixed',
            default => 'class:'.$actual,
        };
        if (array_key_exists($category, $expected)) {
            $expected[$category] = true;
            continue;
        }
        if (str_starts_with($category, 'class:') && array_key_exists('object', $expected)) {
            $expected['object'] = true;
            continue;
        }
        if ($category === 'array' && array_key_exists('object', $expected)) {
            $expected['object'] = true;
            continue;
        }

        return false;
    }

    foreach ($expected as $category => $matched) {
        if ($category === 'null' && $optional && !$matched) continue;
        if (!$matched) return false;
    }

    return true;
}

/** @param array<string, string> $phpSymbolsByTypeScript */
function typescriptTypeMatchesPhpDoc(
    string $type,
    mixed $phpDocType,
    array $phpSymbolsByTypeScript,
): bool {
    if (!is_string($phpDocType)) return false;
    $phpDocType = ltrim(trim($phpDocType), '\\');
    $expectedClass = mappedParameterType($type, $phpSymbolsByTypeScript);
    if ($expectedClass !== null) {
        $separator = strrpos($expectedClass, '\\');
        $shortName = $separator === false ? $expectedClass : substr($expectedClass, $separator + 1);

        return $phpDocType === $expectedClass || $phpDocType === $shortName;
    }

    return match ($type) {
        'any' => $phpDocType === 'mixed',
        'boolean' => $phpDocType === 'bool',
        'number' => $phpDocType === 'int' || $phpDocType === 'float' || $phpDocType === 'int|float',
        'string' => $phpDocType === 'string',
        default => false,
    };
}

/** @param array<string, string> $phpSymbolsByTypeScript */
function mappedParameterType(string $type, array $phpSymbolsByTypeScript): ?string
{
    $externalTypes = [
        'puppeteer.Browser' => 'Pam\\Browser\\Browser',
        'puppeteer.Page' => 'Pam\\Browser\\Page',
        'puppeteer.PuppeteerNodeLaunchOptions & puppeteer.ConnectOptions' => 'Pam\\Browser\\Chromium\\LaunchOptions',
        'Date' => DateTimeInterface::class,
    ];
    if (isset($externalTypes[$type])) return $externalTypes[$type];

    $parts = preg_split('/\s*\|\s*/', $type);
    if (!is_array($parts)) return null;
    $parts = array_values(array_filter(
        $parts,
        static fn (string $part): bool => $part !== 'null' && $part !== 'undefined',
    ));
    if (count($parts) !== 1 || preg_match('/^[A-Za-z_$][A-Za-z0-9_$]*$/', $parts[0]) !== 1) {
        return null;
    }

    return $phpSymbolsByTypeScript[$parts[0]] ?? null;
}

function parameterTypeMatches(ParameterKind $kind, ?ReflectionType $type): bool
{
    $names = reflectionReturnNames($type);
    $enumBackingType = null;
    if ($type instanceof ReflectionNamedType && enum_exists($type->getName())) {
        $enum = new ReflectionEnum($type->getName());
        $backingType = $enum->getBackingType();
        $enumBackingType = $backingType?->getName();
    }

    return match ($kind) {
        ParameterKind::Boolean => in_array('bool', $names, true)
            && array_diff($names, ['bool', 'null']) === [],
        ParameterKind::Number => $enumBackingType === 'int'
            || ((in_array('int', $names, true) || in_array('float', $names, true))
                && array_diff($names, ['int', 'float', 'null']) === []),
        ParameterKind::String => $enumBackingType !== null
            || (in_array('string', $names, true) && array_diff($names, ['string', 'null']) === []),
        ParameterKind::Array => in_array('array', $names, true)
            && array_diff($names, ['array', 'null']) === [],
        ParameterKind::Unknown => true,
    };
}

/** @return list<string> */
function reflectionReturnNames(?ReflectionType $type): array
{
    if ($type instanceof ReflectionNamedType) {
        $names = [$type->getName()];
        if ($type->allowsNull() && $type->getName() !== 'null') $names[] = 'null';
        sort($names);

        return $names;
    }
    if ($type instanceof ReflectionUnionType) {
        $names = array_map(
            static fn (ReflectionType $member): string => $member instanceof ReflectionNamedType
                ? $member->getName()
                : (string) $member,
            $type->getTypes(),
        );
        sort($names);

        return $names;
    }

    return [];
}

$command = $argv[1] ?? 'check';
match ($command) {
    'refresh' => refresh(),
    'check' => check(in_array('--allow-incomplete', $argv, true)),
    'certify' => certify($argv[2] ?? '', in_array('--dry-run', $argv, true)),
    default => fail('usage: bin/parity refresh | check [--allow-incomplete] | certify <report.json> [--dry-run]'),
};
